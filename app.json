{
  "expo": {
    "name": "Dream AI",
    "slug": "dreamverse-fresh",
    "owner": "ioakimxtz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ioakimxtz.dreamversefresh",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture faces for dream videos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select images.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to record your dream descriptions."
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "com.googleusercontent.apps.657368542105-1o90lpfe1uo82bcbb22b82kv4rvba9ia"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7C86FF"
      },
      "package": "com.ioakimxtz.dreamversefresh",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA", 
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "com.android.vending.BILLING"
      ],
      "versionCode": 1,
      "jsEngine": "hermes"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.657368542105-1o90lpfe1uo82bcbb22b82kv4rvba9ia"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7C86FF"
        }
      ],
      "expo-av",
      "expo-secure-store",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0fa46614-499e-4052-90a9-43f3c98b573b"
      }
    }
  }
}